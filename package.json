{
  "name": "@figma/pickup-design-system",
  "version": "0.1.0",
  "description": "React implementation of the Pickup design system (tokens + components) from Figma, with Storybook and Code Connect",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/index.css",
    "./tokens.css": "./src/tokens/tokens.css"
  },
  "files": [
    "dist",
    "src/tokens"
  ],
  "sideEffects": [
    "**/*.css",
    "./src/index.ts",
    "./dist/index.js"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json --noEmit && vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p app/tsconfig.json",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "figma:generate-icons": "node scripts/generate-icon-code-connect.mjs",
    "figma:parse": "figma connect parse",
    "figma:publish": "figma connect publish",
    "app": "vite --config app/vite.config.ts",
    "build:app": "vite build --config app/vite.config.ts"
  },
  "peerDependencies": {
    "@heroicons/react": "^2.2.0",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@figma/code-connect": "^2.1.0",
    "@heroicons/react": "^2.2.0",
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/react-vite": "^10.6.7",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "^10.6.7",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vite-plugin-dts": "^5.1.2"
  }
}
